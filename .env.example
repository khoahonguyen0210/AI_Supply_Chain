# Copy to .env and adjust (scripts/stack.sh does this and appends random secrets). Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scm
POSTGRES_USER=scm
BACKEND_PORT=8080
MANAGEMENT_PORT=8081
FRONTEND_PORT=3000
SYNTHETIC_SEED=42

# Host port for PostgreSQL in the Docker stack.
SCM_DB_HOST_PORT=5432
# Image tag for the locally built containers.
SCM_VERSION=local

# Secrets (required). scripts/stack.sh generates them; set them yourself when not using it.
# POSTGRES_PASSWORD=
# SCM_JWT_SECRET=          # 32+ bytes
# SCM_ML_INTERNAL_TOKEN=   # shared by backend and engine
# SCM_DEMO_PASSWORD=       # password of the demo accounts (planner, manager, finance, admin)

# Optional: Claude as planner and answer writer (SCM_ML_PLANNER=claude). Costs API credits.
# ANTHROPIC_API_KEY=
# SCM_ML_PLANNER=rule
