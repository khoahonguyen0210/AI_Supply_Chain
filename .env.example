# Never commit .env; scripts/stack.sh creates it with random secrets.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scm
POSTGRES_USER=scm
BACKEND_PORT=8080
MANAGEMENT_PORT=8081
FRONTEND_PORT=3000
SYNTHETIC_SEED=42

SCM_DB_HOST_PORT=5432
SCM_VERSION=local

# Required secrets
# POSTGRES_PASSWORD=
# SCM_JWT_SECRET=  # 32+ bytes
# SCM_ML_INTERNAL_TOKEN=
# SCM_DEMO_PASSWORD=

